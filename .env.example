# Neon Postgres connection string.
DATABASE_URL="postgres://USER:PASSWORD@HOST.neon.tech/DB?sslmode=require"

# Vercel Blob read/write token.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_token"

# Long random value used to sign user sessions.
SESSION_SECRET="replace-with-a-long-random-secret"

# Secret header required when calling POST /api/setup.
SETUP_SECRET="replace-with-a-long-random-setup-secret"

# Maximum total accounts during the first beta.
BETA_USER_LIMIT="10"

# Optional/CI-only Neon database used exclusively by the destructive
# registration-limit concurrency integration test. Never point this at production.
REGISTRATION_LIMIT_TEST_DATABASE_URL=""

# Local one-off override allowing the test URL to match DATABASE_URL.
# Do not configure this in Vercel.
ALLOW_SHARED_REGISTRATION_LIMIT_TEST_DB="false"

# Leave empty when frontend and API are served by the same Vercel project.
VITE_API_BASE_URL=""
