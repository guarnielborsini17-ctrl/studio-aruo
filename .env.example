# Neon Postgres connection string.
DATABASE_URL="postgres://USER:PASSWORD@HOST.neon.tech/DB?sslmode=require"

# Vercel Blob read/write token.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_token"

# Long random value used to sign user sessions.
SESSION_SECRET="replace-with-a-long-random-secret"

# Secret header required when calling POST /api/setup.
SETUP_SECRET="replace-with-a-long-random-setup-secret"

# Leave empty when frontend and API are served by the same Vercel project.
VITE_API_BASE_URL=""
